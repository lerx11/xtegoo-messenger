// XTegoo Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Модель пользователя
model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  username      String?   @unique
  firstName     String?
  lastName      String?
  avatar        String?
  bio           String?
  isBusiness    Boolean   @default(false)
  businessName  String?
  businessDesc  String?
  language      String    @default("ru")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Связи
  chatMembers   ChatMember[]
  messages      Message[]
  messageStatuses MessageStatus[]
  callsAsCaller Call[] @relation("caller")
  callsAsReceiver Call[] @relation("receiver")
  stories       Story[]
  services      Service[]
  products      Product[]
  bookingsAsClient Booking[] @relation("clientBookings")
  calendarEvents CalendarEvent[]
  ordersAsBuyer Order[] @relation("buyerOrders")
  esims         ESIM[]
}

// Модель чата
model Chat {
  id        String      @id @default(cuid())
  isGroup   Boolean     @default(false)
  name      String?
  avatar    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Связи
  members   ChatMember[]
  messages  Message[]
}

// Участники чата
model ChatMember {
  userId  String
  chatId  String
  isAdmin Boolean @default(false)
  joinedAt DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat    Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
}

// Сообщение
model Message {
  id         String   @id @default(cuid())
  chatId     String
  senderId   String
  type       String   @default("text") // text, image, video, audio, document, location
  content    String?
  fileUrl    String?
  replyToId  String?
  createdAt  DateTime @default(now())

  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])
  replyTo    Message? @relation("reply", fields: [replyToId], references: [id])
  replies    Message[] @relation("reply")
  statuses   MessageStatus[]
}

// Статус сообщения
model MessageStatus {
  messageId String
  userId    String
  status    String   @default("sent") // sent, delivered, read
  updatedAt DateTime @updatedAt

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

// Звонок
model Call {
  id         String   @id @default(cuid())
  callerId   String
  receiverId String
  type       String   // audio, video
  status     String   // incoming, answered, ended, missed
  duration   Int      @default(0) // в секундах
  roomName   String?
  createdAt  DateTime @default(now())

  caller     User     @relation("caller", fields: [callerId], references: [id])
  receiver   User     @relation("receiver", fields: [receiverId], references: [id])
}

// Сторис
model Story {
  id        String   @id @default(cuid())
  userId    String
  mediaUrl  String
  type      String   // image, video
  createdAt DateTime @default(now())
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Услуга (бизнес)
model Service {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  price       Float
  duration    Int      // в минутах
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

// Товар (маркетплейс)
model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  price       Float
  images      String[] // массив URL изображений
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
}

// Запись на услугу
model Booking {
  id        String   @id @default(cuid())
  serviceId String
  clientId  String
  date      DateTime
  status    String   @default("pending") // pending, confirmed, cancelled, completed
  createdAt DateTime @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  client    User     @relation("clientBookings", fields: [clientId], references: [id])
}

// Событие календаря
model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        DateTime
  time        String?
  color       String?
  reminder    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Заказ (маркетплейс)
model Order {
  id         String   @id @default(cuid())
  buyerId    String
  productId  String
  status     String   @default("pending") // pending, paid, shipped, delivered, cancelled
  createdAt  DateTime @default(now())

  buyer      User     @relation("buyerOrders", fields: [buyerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// eSIM
model ESIM {
  id        String   @id @default(cuid())
  userId    String
  provider  String   // Zetexa, Airalo, Holafly
  plan      String
  status    String   @default("active") // active, used, expired
  iccid     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Кеш переводов
model TranslationCache {
  id             String   @id @default(cuid())
  sourceText     String
  translatedText String
  sourceLang     String
  targetLang     String
  createdAt      DateTime @default(now())

  @@unique([sourceText, targetLang])
  @@index([sourceText, targetLang])
}
